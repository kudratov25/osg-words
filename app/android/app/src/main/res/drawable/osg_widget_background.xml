<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors lib/widgets/glass_container.dart's recipe as closely as
     RemoteViews allows: solid dark base (stands in for the app's
     BackdropFilter blur, which RemoteViews has no equivalent for) +
     diagonal white gradient sheen + 1dp translucent white border, all at
     GlassContainer's 24dp corner radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E60B0E14" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
