<?xml version="1.0" encoding="utf-8"?>
<!-- "Show meaning" pill on the Home Screen widget: subtle translucent
     white fill + faint border on the dark glass background, fully rounded
     (radius larger than the button height). Text color (accent #7FB3FF)
     is set on the TextView in osg_widget.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <stroke android:width="1dp" android:color="#337FB3FF" />
    <corners android:radius="999dp" />
</shape>
